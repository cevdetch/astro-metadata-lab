---
import { cases, caseHref, renderCase } from '../../../metadata-cases/cases';

export function getStaticPaths() {
  // Leave the 404 URL absent so the host serves 404.html with a real 404 status.
  return cases.filter(definition => definition.options.status !== 404).map(definition => ({
    params: { group: definition.group, id: definition.id },
    props: { definition },
  }));
}

const { definition } = Astro.props;
const fixture = renderCase(definition, Astro.url.origin, import.meta.env.BASE_URL);
if (definition.options.redirect) {
  const [group, id] = definition.options.redirect.split('/');
  return Astro.redirect(caseHref({ group: group!, id: id! }, import.meta.env.BASE_URL), 302);
}
// Dev responses use these values; the build emits Cloudflare host rules.
if (import.meta.env.DEV) {
  Astro.response.status = fixture.status;
  for (const [key, value] of Object.entries(fixture.headers)) Astro.response.headers.set(key, value);
}
---
<Fragment set:html={fixture.html} />
